{
  "name": "mermaid-hillchart",

  // https://github.com/devcontainers/images/tree/main/src/typescript-node
  // https://mcr.microsoft.com/en-us/artifact/mar/devcontainers/typescript-node/tags
  "image": "mcr.microsoft.com/devcontainers/typescript-node:5-26-trixie",

  // Configure tool-specific properties.
  "customizations": {
    "vscode": {
      "extensions": ["oxc.oxc-vscode", "-dbaeumer.vscode-eslint"],
    }
  },

  "postCreateCommand": {
    "install-pnpm": "npm uninstall -g pnpm && npm install -g corepack && corepack enable",
    "chown": "sudo chown -R node:node ${containerWorkspaceFolder}/node_modules"
  },
  "waitFor": "postCreateCommand",

  "remoteUser": "node",

  "mounts": [
    // Move `node_modules` folder into dedicated volume to improve disk I/O performance
    "source=node_modules-${devcontainerId},target=${containerWorkspaceFolder}/node_modules,type=volume",
  ]
}
