{
  "name": "mermaid-hillchart-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm run -r --if-present build",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "pnpm run -r --if-present lint",
    "lint:extra": "pnpm run -r --if-present lint:extra",
    "test": "pnpm run -r --if-present test"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@tsconfig/node26": "^26.0.1",
    "@tsconfig/strictest": "^2.0.8",
    "@types/node": "^26.6.6",
    "happy-dom": "^20.9.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "publint": "^0.3.25",
    "tsdown": "^0.23.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "~12.16.1",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": ">=26",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=26"
  }
}
