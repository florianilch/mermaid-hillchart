{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": ["@tsconfig/node26", "@tsconfig/strictest"],
  "compilerOptions": {
    "noEmit": true,
    "moduleResolution": "bundler",
    "module": "esnext",
    "verbatimModuleSyntax": true,
    "allowJs": true,
    "lib": [
      // from @tsconfig/node26
      "ES2025",
      "ESNext.Collection",
      "ESNext.Temporal",
      // additional libs for browser env
      "DOM",
      "DOM.Iterable"
    ]
  }
}
